# Add these non-secret settings to the existing API process configuration.
# Choose a CURRENT tool-capable OpenRouter model ending in :free. No fallback.
# ASK_MODEL=your-selected-model:free
# Supply OPENROUTER_API_KEY securely on the Python server; never in the browser.
# The same key supplies query embeddings for the ETL default model through OpenRouter.
OPENROUTER_EMBEDDING_TIMEOUT=20
ASK_MODEL_REQUESTS=8
ASK_TOOL_CALLS=12
ASK_API_TIMEOUT=20
ASK_DEADLINE=90
ASK_TELEMETRY=false
ASK_CAPTURE_CONTENT=false
# LOGFIRE_TOKEN is optional and should also be supplied securely server-side.
