
# Chat can use an OpenRouter router or a specific tool-capable model.
ASK_MODEL=openrouter/free
OPENROUTER_EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
OPENROUTER_EMBEDDING_TIMEOUT=20
ASK_MODEL_REQUESTS=8
ASK_TOOL_CALLS=12
ASK_API_TIMEOUT=20
ASK_DEADLINE=90
ASK_TELEMETRY=true # enable logfire
ASK_CAPTURE_CONTENT=true # include model prompts, responses and tools
ASK_FEEDBACK_ENABLE=true # enable user feedback posts to logfire
